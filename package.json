{
  "name": "earl-databricks-workshop-ai-functions",
  "version": "1.0.0",
  "description": "Materials for a Databricks AI Functions workshop at EARL Conference",
  "private": true,
  "scripts": {
    "deck:watch": "marp --theme deck/theme.css -w deck/slides.md",
    "deck:html": "marp --theme deck/theme.css --allow-local-files deck/slides.md -o deck/slides.html",
    "deck:pdf": "marp --theme deck/theme.css --allow-local-files --pdf deck/slides.md -o deck/dist/slides.pdf",
    "deck:pptx": "marp --theme deck/theme.css --allow-local-files --pptx deck/slides.md -o deck/dist/slides.pptx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alcole/earl-databricks-workshop-ai-functions.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  }
}
